---
import '../styles/tokens.css';
import '../styles/sl-palette.css';
import '../styles/search-bridge.css';
import '../styles/site.css';
import Search from 'virtual:starlight/components/Search';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { url } from '../lib/url';

interface Props {
  title: string;
  description: string;
  current?: 'home' | 'the-app' | 'docs' | 'support' | 'privacy';
  /** Set on pages that draw their own full-bleed hero. */
  wide?: boolean;
  /** Keep the page out of the search index and search engines (the 404). */
  noindex?: boolean;
}

const { title, description, current, wide = false, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <link rel="sitemap" href={url('/sitemap-index.xml')} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    {noindex && <meta name="robots" content="noindex" />}

    {/*
      Applied before first paint so the page never flashes the wrong theme.
      Same key and same defaulting rule as Starlight's own ThemeProvider, which
      is what lets one preference carry across both shells.
    */}
    <script is:inline>
      (() => {
        const stored = (() => {
          try {
            return localStorage.getItem('starlight-theme');
          } catch {
            return null;
          }
        })();
        // No stored choice: follow the system — light unless it asks for dark.
        // (Starlight resolves "no preference" to dark instead; every current
        // browser reports one or the other, so the two shells agree.)
        const theme =
          stored === 'light' || stored === 'dark'
            ? stored
            : window.matchMedia('(prefers-color-scheme: dark)').matches
              ? 'dark'
              : 'light';
        document.documentElement.dataset.theme = theme;
      })();
    </script>
  </head>

  <body class={wide ? 'is-wide' : ''}>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="page-header">
      <SiteHeader current={current}>
        <Search slot="search" />
      </SiteHeader>
    </header>
    <!--
      ⚠️ `data-pagefind-body` is what puts these pages in the search index.

      Without it Pagefind indexed only the Starlight docs — 20 pages — and the five
      custom routes were invisible: the landing page, the app tour, support, privacy
      and the disclaimer. Those are exactly the pages somebody arriving from the App
      Store listing looks for, and searching the site for "privacy" returned the map
      page instead.
    -->
    <main id="main" data-pagefind-body={noindex ? undefined : ''}>
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>

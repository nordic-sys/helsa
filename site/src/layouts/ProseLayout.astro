---
import BaseLayout from './BaseLayout.astro';

/**
 * The long-form pages: privacy, disclaimer, support.
 *
 * They get a narrow measure and generous rules between sections rather than the
 * documentation shell, because they are read start to finish by someone
 * deciding whether to trust the thing — not skimmed for a command to copy.
 */
interface Props {
  frontmatter: {
    title: string;
    description: string;
    /** Standfirst under the heading: a date, or one line of context. */
    lede?: string;
    current?: 'the-app' | 'support';
  };
}

const { title, description, lede, current } = Astro.props.frontmatter;
---

<BaseLayout title={`${title} — Helsa`} description={description} current={current}>
  <div class="shell prose-page">
    <header class="prose-header">
      <h1>{title}</h1>
      {lede && <p class="lede">{lede}</p>}
    </header>
    <div class="prose">
      <slot />
    </div>
  </div>
</BaseLayout>

---
/**
 * Starlight `PageTitle` override: the default heading, and above it — on the
 * four Getting started pages only — where you are on the path.
 *
 * "Getting started · step 3 of 4" and four segments with the current one
 * filled. ⚠️ Position, not progress: the earlier segments are NOT drawn as
 * done, because the site cannot know that they are (see lib/steps.ts).
 *
 * The bar is in normal flow, not sticky: Starlight's fixed header and its
 * mobile "On this page" bar already own the top of the viewport, and every
 * anchor offset is computed from them.
 */
import Default from '@astrojs/starlight/components/PageTitle.astro';
import { STEPS, stepOf } from '../../lib/steps';
import { url } from '../../lib/url';

const step = stepOf(Astro.locals.starlightRoute.id);
---

{
  step && (
    <nav class="step-bar" aria-label="Getting started">
      <p class="step-bar__label">
        <a href={url('/getting-started/')}>Getting started</a> · step {step.n} of {STEPS.length}
      </p>
      <ol class="step-bar__track">
        {STEPS.map((s) => (
          <li>
            <a
              href={url(`/${s.id}/`)}
              aria-current={s.n === step.n ? 'step' : undefined}
              title={`Step ${s.n}: ${s.label}`}
            >
              <span class="sr-only">Step {s.n}: {s.label}</span>
            </a>
          </li>
        ))}
      </ol>
      <p class="step-bar__where">{step.where}</p>
    </nav>
  )
}
<Default />

<style>
  .step-bar {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-top: 0.5rem;
  }
  .step-bar__label {
    margin: 0;
    font-size: 14px;
    font-weight: 600;
    color: var(--helsa-accent-text);
  }
  .step-bar__label a { color: inherit; }
  .step-bar__track {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .step-bar__track li { margin: 0; }
  /* 6px drawn, a taller hit area around it. */
  .step-bar__track a {
    display: flex;
    align-items: center;
    height: 24px;
  }
  .step-bar__track a::before {
    content: '';
    display: block;
    width: 100%;
    height: 6px;
    border-radius: 3px;
    background: var(--helsa-surface-3);
  }
  .step-bar__track a:hover::before { background: var(--helsa-border-strong); }
  .step-bar__track a[aria-current='step']::before { background: var(--helsa-accent); }
  .step-bar__where {
    margin: 0;
    font-size: 13px;
    color: var(--helsa-text-dim);
  }
  .sr-only {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip-path: inset(50%); white-space: nowrap; border: 0;
  }
</style>

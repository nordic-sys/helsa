---
/**
 * Starlight `Pagination` override: previous and next as two cards, and the
 * next one is the primary action — the path continues forward.
 *
 * On the Getting started steps the cards say which step they lead to
 * ("← Step 2 · Device token", "Step 4 → · First sync"), so the numbered path
 * in the sidebar and the step bar is repeated where the reader finishes the
 * page. Elsewhere they say "Previous" and "Next".
 */
import { stepOf } from '../../lib/steps';

const { pagination } = Astro.locals.starlightRoute;
const { prev, next } = pagination;
const prevStep = stepOf(prev?.href);
const nextStep = stepOf(next?.href);
---

{
  (prev || next) && (
    <nav class="pager print:hidden" aria-label="Previous and next page">
      {prev ? (
        <a class="pager-link" href={prev.href} rel="prev">
          <span class="pager-kicker">← {prevStep ? `Step ${prevStep.n}` : 'Previous'}</span>
          <span class="pager-title">{prev.label}</span>
        </a>
      ) : (
        <span />
      )}
      {next && (
        <a class="pager-link pager-link--next" href={next.href} rel="next">
          <span class="pager-kicker">{nextStep ? `Step ${nextStep.n}` : 'Next'} →</span>
          <span class="pager-title">{next.label}</span>
        </a>
      )}
    </nav>
  )
}

<style>
  .pager {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(16rem, 100%), 1fr));
    gap: 12px;
  }
  .pager-link {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-height: 64px;
    padding: 16px 20px;
    border-radius: var(--helsa-radius);
    border: 1px solid var(--helsa-card-border);
    background: var(--helsa-surface);
    color: var(--helsa-text);
    text-decoration: none;
    overflow-wrap: anywhere;
  }
  .pager-link:hover { box-shadow: var(--helsa-shadow-pop); }
  .pager-link:focus-visible {
    outline: 2px solid var(--helsa-focus);
    outline-offset: 2px;
  }
  .pager-kicker {
    font-size: 13px;
    color: var(--helsa-text-dim);
  }
  .pager-title {
    font-size: 17px;
    font-weight: 600;
    line-height: 1.3;
    color: var(--helsa-accent-text);
  }
  .pager-link--next {
    align-items: flex-end;
    text-align: end;
    background: var(--helsa-accent-text);
    border-color: var(--helsa-accent-text);
  }
  /* On the filled card both lines are the on-accent colour: white on #0B6E7A
     is 5.9:1; the mockup's tinted "Step 4" kicker was 4.15:1. */
  .pager-link--next .pager-kicker,
  .pager-link--next .pager-title {
    color: var(--helsa-on-accent);
  }
</style>

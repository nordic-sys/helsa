[ req ]
default_md          = sha256
prompt              = no
distinguished_name  = dn

[ dn ]
CN = helsa-client
O  = Helsa

# clientAuth ONLY — this certificate must never be able to pass itself off as a
# server. The proxy forwards the CN to the API in the X-Client-Cert-CN header, so
# the backend knows which device is speaking (docs/08 §4).
[ v3_client ]
basicConstraints       = CA:FALSE
keyUsage               = critical, digitalSignature
extendedKeyUsage       = clientAuth
subjectKeyIdentifier   = hash

# The Helsa reverse proxy — the ONLY component that faces outwards.
# Plan: docs/07-infra-deployment.md §4, decision: ADR-0003.
#
# Two separate surfaces, with two separate gates:
#   :443   API — publicly routable, mTLS MANDATORY (this is where the phone syncs)
#   :8443  Web — NOT port-forwarded on the router, and filtered by IP on top of that
{
	# No automatic Let's Encrypt: we use our own private CA.
	auto_https off
	admin off
}

# ---------------------------------------------------------------------------
# API — the mTLS gate
# ---------------------------------------------------------------------------
https://:443 {
	tls /etc/caddy/pki/server.crt /etc/caddy/pki/server.key {
		client_auth {
			# require_and_verify: without a valid client certificate signed by OUR
			# CA the TLS handshake fails — the request never reaches the HTTP layer.
			mode require_and_verify
			trust_pool file {
				pem_file /etc/caddy/pki/ca.crt
			}
		}
	}

	# ⚠️ A body cap, at the first thing that touches the request.
	#
	# The application refuses a batch of more than 50,000 ITEMS — but only after the
	# whole JSON body has been read and decoded, so a single enormous body is already
	# in memory by the time that limit has an opinion. The hardening checklist claimed
	# this was covered; it was covered one layer too late.
	#
	# 32 MB against a documented chunk of 50,000 items: a sample serialises to roughly
	# 200 bytes, so a legitimate maximum chunk is around 10 MB. The cap is meant to stop
	# the absurd, not to second-guess the contract.
	request_body {
		max_size 32MB
	}

	# This is how the backend knows which device is speaking (docs/08 §4).
	#
	# Every header the backend may ever trust is SET here, never passed through:
	# `header_up Name value` replaces whatever the client sent under that name.
	#   - X-Client-Cert-*: from the TLS handshake, not from the request.
	#   - X-Helsa-Listener: which door the request came through. A cookie does not
	#     know ports (RFC 6265 §8.5), so the backend needs this to accept a web
	#     session only from the web door (docs/36 §9, C10).
	#   - X-Real-IP: the client's address as Caddy saw it. The backend's RealIP
	#     reads True-Client-IP first, then X-Real-IP — so the first is removed and
	#     the second set, or any caller could choose the address a rate limit
	#     counts against (docs/36 §9, C8).
	handle /v1/* {
		reverse_proxy api:8080 {
			header_up X-Client-Cert-Subject {http.request.tls.client.subject}
			header_up X-Client-Cert-Serial {http.request.tls.client.serial}
			header_up X-Helsa-Listener device
			header_up -True-Client-IP
			header_up X-Real-IP {client_ip}
		}
	}

	# Health/readiness: without a certificate these are unreachable too (the mTLS
	# applies to the whole site), but they also stay trivial in content — no internal
	# state. /readyz reports whether the DB + Redis + MQ are reachable, which is why
	# it is needed from outside as well.
	@health path /healthz /readyz
	handle @health {
		reverse_proxy api:8080
	}

	handle {
		respond "not found" 404
	}
}

# ---------------------------------------------------------------------------
# Web dashboard — LAN / WireGuard only
# ---------------------------------------------------------------------------
# No client certificate: in a browser that would be uncomfortable. Here the gate is
# the network. Two defences that reinforce each other:
#   1. this port is NOT forwarded on the router (primary, at the network level)
#   2. a remote_ip filter for the LAN + WireGuard ranges (secondary, in case somebody
#      does open it after all)
https://:8443 {
	tls /etc/caddy/pki/server.crt /etc/caddy/pki/server.key

	@allowed remote_ip {$LAN_SUBNET} {$WG_SUBNET}

	handle @allowed {
		# The web reads the same API, just not through mTLS.
		#
		# ⛔ There is no client certificate on this port, so the certificate headers
		# are REMOVED, not left to whatever the browser — or anybody on the LAN —
		# sends: until 2026-10 they were passed through untouched (docs/36 §1.2/4).
		# The rest as on :443.
		handle /v1/* {
			reverse_proxy api:8080 {
				header_up -X-Client-Cert-Subject
				header_up -X-Client-Cert-Serial
				header_up X-Helsa-Listener web
				header_up -True-Client-IP
				header_up X-Real-IP {client_ip}
			}
		}
		handle {
			reverse_proxy web:80
		}
	}

	handle {
		respond "forbidden" 403
	}
}

# Helsa — local dev infrastructure config. Copy it to .env: `cp .env.example .env`
# .env is gitignored; these are LOCAL development values only, never production ones.

# --- Images ---
# The application services (api, worker, web, token) run PUBLISHED images by
# default; `docker compose` pulls them rather than building anything.
#
# ⚠️ If the GHCR packages are private, pulling needs a GitHub login first:
#     echo $GITHUB_TOKEN | docker login ghcr.io -u <your-github-user> --password-stdin
# Package visibility is set per package and is INDEPENDENT of the repository's:
# a public repository can still publish private images.
#
# To build from this checkout instead: HELSA_PULL_POLICY=build (or `make prod-build`).
HELSA_PULL_POLICY=always
# ⚠️ `:main` is the tip of the default branch — the newest build, not a release. It is the
# default because it is what exists: `latest` is published only from a `v*` tag, and there are
# no releases yet. Pin `sha-<short>` if you want a build that cannot move under you.
#HELSA_BACKEND_IMAGE=ghcr.io/nordic-sys/helsa/backend:main
#HELSA_WEB_IMAGE=ghcr.io/nordic-sys/helsa/web:main

# --- TimescaleDB (timescaledb-ha:pg18) ---
TIMESCALE_HOST_PORT=5433        # host port (instead of 5432, so it does not clash with an existing Postgres)
POSTGRES_DB=helsa
POSTGRES_USER=helsa             # locally helsa is the superuser (the -ha image honours POSTGRES_USER). In production, a scoped helsa role.
POSTGRES_PASSWORD=helsa_local_dev
# Local connection string: postgres://helsa:helsa_local_dev@localhost:5433/helsa

# --- Redis ---
REDIS_HOST_PORT=6380            # host port (instead of 6379)
REDIS_PASSWORD=helsa_local_dev

# --- RabbitMQ ---
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MGMT_PORT=15672        # management UI: http://localhost:15672
RABBITMQ_USER=helsa
RABBITMQ_PASSWORD=helsa_local_dev

# --- Home Assistant over MQTT (OFF) ---
# The worker publishes DAILY SUMMARIES and the sync-freshness heartbeat with Home
# Assistant discovery. It starts only if HELSA_MQTT_URL is set — leave it empty and
# nothing connects, nothing is published, and no broker is needed.
#
# Point it at the broker Home Assistant already uses. `make mqtt-up` starts a
# throwaway one on 127.0.0.1:1883 for testing (profile-gated, anonymous, no TLS).
# Details: docs/integrations/home-assistant.md
#HELSA_MQTT_URL=mqtt://helsa:CHANGE_ME@mqtt.lan:1883
#HELSA_MQTT_PREFIX=helsa
#HELSA_MQTT_DISCOVERY_PREFIX=homeassistant
#HELSA_MQTT_PUBLISH_INTERVAL=6h
#HELSA_MQTT_FRESHNESS_INTERVAL=15m
#HELSA_MQTT_EXPIRE_AFTER=90m
# Only needed if the database holds more than one user — the publisher refuses to
# guess which one's health data goes on the broker.
#HELSA_MQTT_USER_ID=

# The host port `make mqtt-up` publishes the test broker on.
MQTT_HOST_PORT=1883

# Helsa backend — local dev env. Copy it to .env: `cp .env.example .env`
# The defaults point at the host ports published by the deploy/ docker-compose stack
# (TimescaleDB :5433, Redis :6380, RabbitMQ :5672).

HELSA_HTTP_ADDR=:8080
HELSA_DATABASE_URL=postgres://helsa:helsa_local_dev@localhost:5433/helsa?sslmode=disable
HELSA_REDIS_ADDR=localhost:6380
HELSA_REDIS_PASSWORD=helsa_local_dev
HELSA_RABBITMQ_URL=amqp://helsa:helsa_local_dev@localhost:5672/
HELSA_INGEST_QUEUE=helsa.ingest

# Auth
HELSA_JWT_SECRET=dev-only-insecure-secret-change-me
HELSA_APPLE_AUDIENCES=com.nordic-sys.Helsa
HELSA_APPLE_ISSUER=https://appleid.apple.com
# Local dev: /auth/apple accepts the "dev:<apple_sub>" token without JWKS (for the smoke test).
HELSA_AUTH_DEV_MODE=true
